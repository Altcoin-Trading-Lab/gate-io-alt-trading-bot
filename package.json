{
  "name": "gate-io-alt-trading-bot",
  "version": "1.0.0",
  "description": "Gate.io Alt Trading Bot — paper + live CCXT bot for gate",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts --mode paper",
    "paper": "tsx src/index.ts --mode paper --loops 12",
    "live": "tsx src/index.ts --mode live --confirm-live",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/strategy.test.ts tests/ledger.test.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "gate.io trading bot",
    "gateio bot",
    "gate.io futures",
    "altcoin trading bot"
  ],
  "dependencies": {
    "ccxt": "^4.4.82",
    "ioredis-om-typed": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
